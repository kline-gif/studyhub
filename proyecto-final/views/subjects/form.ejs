<section class="card narrow">
  <h1><%= isEdit ? 'Editar asignatura' : 'Nueva asignatura' %></h1>
  <form method="POST" action="<%= action %>">
    <label>Nombre
      <input type="text" name="name" value="<%= subject.name || '' %>" required maxlength="80" placeholder="Estructuras de Datos y Algoritmos">
    </label>
    <div class="row">
      <label>Código
        <input type="text" name="code" value="<%= subject.code || '' %>" maxlength="20" placeholder="EDA-201">
      </label>
      <label>Créditos
        <input type="number" name="credits" value="<%= subject.credits || 6 %>" min="1" max="30" required>
      </label>
      <label>Cuatrimestre
        <input type="text" name="semester" value="<%= subject.semester || '' %>" maxlength="20" placeholder="2026-1">
      </label>
    </div>
    <div class="actions">
      <button class="btn" type="submit"><%= isEdit ? 'Guardar cambios' : 'Crear asignatura' %></button>
      <a class="btn btn-secondary" href="/subjects">Cancelar</a>
    </div>
  </form>
</section>
